          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "unit": {
                    "enum": [
                      "CURRENCY",
                      "PRICE"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "currency"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "currency"
                  ]
