              "const": "RESOLVED"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unit": {
              "enum": [
                "COUNT",
                "SHARES",
                "RATIO",
                "PERCENT",
                "CURRENCY",
                "PRICE",
                "MULTIPLE",
                "DAYS",
                "SESSIONS",
                "SCORE"
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "not": {
