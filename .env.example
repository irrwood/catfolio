# Catfolio — environment variables template
# Copy to .env and fill in only the integrations you want.
# All keys are optional. Run with CATFOLIO_DEMO=1 to try without any keys.
# Key setup links are listed in README.md under "Where To Get API Keys".

# Trading 212 (portfolio sync)
TRADING212_API_KEY=
# Optional for account setups that expose separate key/secret credentials.
TRADING212_API_SECRET=

# Financial Modeling Prep — P/E, P/S, EPS growth (https://financialmodelingprep.com)
FMP_API_KEY=

# Finnhub — valuation fallback when FMP is missing (https://finnhub.io, free tier)
FINNHUB_API_KEY=

# DeepSeek — AI analysis + Strategy Lab evaluation (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# xAI Grok — AI analysis + Strategy Lab evaluation (https://console.x.ai)
XAI_API_KEY=

# OpenAI — AI analysis + Strategy Lab evaluation (https://platform.openai.com)
OPENAI_API_KEY=

# Google Gemini — AI analysis + Strategy Lab evaluation (https://aistudio.google.com)
GEMINI_API_KEY=

# Moonshot Kimi — AI analysis + Strategy Lab evaluation (https://platform.kimi.ai)
MOONSHOT_API_KEY=

# Zhipu GLM — AI analysis + Strategy Lab evaluation (https://bigmodel.cn)
ZHIPU_API_KEY=

# Alibaba Cloud Qwen / DashScope — AI analysis + Strategy Lab evaluation
QWEN_API_KEY=

# OpenRouter — AI analysis through multiple model providers (https://openrouter.ai)
OPENROUTER_API_KEY=

# Massive — after-hours movers (optional)
MASSIVE_API_KEY=

# FRED — macro data: rates, inflation (optional)
FRED_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Override data directory (default: outputs/ inside repo)
# CATFOLIO_DATA_DIR=/path/to/your/data

# Set to 1 to run with static demo data — no broker account or API keys needed
# CATFOLIO_DEMO=1
