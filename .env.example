# Helm — 环境变量模板
# 复制此文件为 .env 并填入你的 API 密钥

# Trading 212 (持仓同步)
TRADING212_API_KEY=

# Financial Modeling Prep (估值数据)
FMP_API_KEY=

# Finnhub (估值补漏，FMP 失效时使用)
FINNHUB_API_KEY=

# DeepSeek (AI 分析)
DEEPSEEK_API_KEY=

# Massive (盘后异动)
MASSIVE_API_KEY=

# FRED (宏观数据，可选)
FRED_API_KEY=

# 数据目录 (CSV 交易文件存放路径，可选)
# HELM_DATA_DIR=
